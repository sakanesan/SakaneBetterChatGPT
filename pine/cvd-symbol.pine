//@version=6
indicator("Cumulative Volume Delta", "CVD", format = format.volume)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
symbolTooltip = "The symbol used for the delta calculation. Leave it empty to use the chart's symbol."
 + " \n\nNote: the calculation still follows the chart's timeframe and time axis, so the selected symbol must trade during the chart's sessions for the data to line up."
symbolInput = input.symbol("", "Symbol", tooltip = symbolTooltip)

anchorInput = input.timeframe("1D", "Anchor period")

dataAggregationTooltip = "Defines how lower timeframe data is aggregated for the delta calculation. \"1 tick\" computes the delta on tick data and is available only on expert plans."
dataAggregationInput = input.string("Time", "Data aggregation", options = ["Time", "1 tick"], tooltip = dataAggregationTooltip)
useTicks = dataAggregationInput == "1 tick"

lowerTimeframeTooltip = "The indicator scans lower timeframe data to approximate up and down volume used in the delta calculation. By default, the timeframe is chosen automatically. These inputs override this with a custom timeframe."
 + " \n\nHigher timeframes provide more historical data, but the data will be less precise."
useCustomTimeframeInput = input.bool(false, "Use custom timeframe", tooltip = lowerTimeframeTooltip, active = not useTicks)
lowerTimeframeInput = input.timeframe("1", "Timeframe", active = useCustomTimeframeInput and not useTicks)

showInfoInput   = input.bool(true, "Show symbol label", group = "Display")
labelSizeInput  = input.string("Large", "Label size", options = ["Small", "Normal", "Large", "Huge"], group = "Display")

var lowerTimeframe = switch
    useTicks                => "1T"
    useCustomTimeframeInput => lowerTimeframeInput
    timeframe.isseconds     => "1S"
    timeframe.isintraday    => "1"
    timeframe.isdaily       => "5"
    => "60"

// An empty symbol input means "use the chart's symbol".
tickerId = symbolInput == "" ? syminfo.tickerid : symbolInput

// ---------------------------------------------------------------------------
// Delta calculation
//
// `ta.requestVolumeDelta()` always works on the chart's symbol, and wrapping it
// in `request.security()` is not possible because nested `request.*` calls are
// not allowed. Instead, we pull the intrabar data of the requested symbol with
// `request.security_lower_tf()` and accumulate the delta ourselves.
// ---------------------------------------------------------------------------
[ltfOpen, ltfClose, ltfVolume] = request.security_lower_tf(tickerId, lowerTimeframe, [open, close, volume])

isNewPeriod = timeframe.change(anchorInput)

var float cvd          = 0.0   // running delta of the current anchor period
var float prevLtfClose = na    // last intrabar close, used to classify doji intrabars
var float totalVolume  = 0.0   // total volume seen, for the "no volume data" check

if isNewPeriod
    cvd := 0.0

float openVolume = cvd
float maxVolume  = cvd
float minVolume  = cvd

int intrabars = na(ltfVolume) ? 0 : ltfVolume.size()

if intrabars > 0
    for i = 0 to intrabars - 1
        float intrabarVolume = nz(ltfVolume.get(i))
        float intrabarOpen   = ltfOpen.get(i)
        float intrabarClose  = ltfClose.get(i)
        // Up bars count as buying volume, down bars as selling volume. Bars that
        // close at their open are classified against the previous intrabar close.
        float delta = switch
            intrabarClose > intrabarOpen => intrabarVolume
            intrabarClose < intrabarOpen => -intrabarVolume
            => na(prevLtfClose) or intrabarClose == prevLtfClose ? 0.0 : intrabarClose > prevLtfClose ? intrabarVolume : -intrabarVolume
        cvd          += delta
        totalVolume  += intrabarVolume
        maxVolume    := math.max(maxVolume, cvd)
        minVolume    := math.min(minVolume, cvd)
        prevLtfClose := intrabarClose

float lastVolume = cvd

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------
col = lastVolume >= openVolume ? color.teal : color.red
hline(0)
plotcandle(openVolume, maxVolume, minVolume, lastVolume, "CVD", color = col, bordercolor = col, wickcolor = col)

// The symbol is shown in a table so it stays pinned to the top right corner of
// the pane instead of drifting with the last bar.
labelSize = switch labelSizeInput
    "Small"  => size.small
    "Normal" => size.normal
    "Huge"   => size.huge
    => size.large

var table infoTable = table.new(position.top_right, 1, 1, bgcolor = color.new(color.gray, 100), frame_width = 0)

if showInfoInput and barstate.islast
    table.cell(infoTable, 0, 0, tickerId + "\n" + anchorInput, text_color = color.white, text_size = labelSize, text_halign = text.align_right, bgcolor = #434651)

// ---------------------------------------------------------------------------
// Error handling
// ---------------------------------------------------------------------------
if barstate.islast
    if totalVolume == 0
        runtime.error("The data vendor doesn't provide volume data for '" + tickerId + "'.")
    if str.endswith(lowerTimeframe, "T") and intrabars == 0
        runtime.error("Not enough tick depth for the current anchor period. The available tick depth ends before reaching the start of the anchor period (" + anchorInput + "). Please shorten the 'Anchor period' input or switch the calculation base from '1 Tick' to 'Time' or higher custom timeframe.")
