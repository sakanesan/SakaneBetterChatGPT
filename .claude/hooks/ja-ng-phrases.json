{
  "_comment": "Stop フック ja-style-check.py が読む NG 表現リスト。severity=hard は 1 件でも差し戻し、soft は 2 件以上で差し戻し。~/.claude/ja-ng-phrases.local.json を置くと rules がマージされる（同じ pattern は後勝ち、severity を off にすると無効化）。",
  "rules": [
    { "pattern": "ここで重要なのは", "label": "前口上", "fix": "事実から書き始める", "severity": "hard" },
    { "pattern": "注目すべき(点|は)", "label": "前口上", "fix": "事実から書き始める", "severity": "hard" },
    { "pattern": "整理すると", "label": "前口上", "fix": "削除して直後の事実につなぐ", "severity": "hard" },
    { "pattern": "順番に見て(いき|い)", "label": "読者案内", "fix": "予告せず本題を書く", "severity": "hard" },
    { "pattern": "結論から(言|申)", "label": "前口上", "fix": "結論をそのまま書く", "severity": "hard" },
    { "pattern": "ポイントは[0-9０-９一二三四五六七八九十]+つ", "label": "前口上", "fix": "中身を先に書く", "severity": "hard" },
    { "pattern": "分けて考える必要があります", "label": "読者案内", "fix": "削除する", "severity": "hard" },
    { "pattern": "まず(確認|押さえ)たいのは", "label": "前口上", "fix": "削除して事実から始める", "severity": "hard" },
    { "pattern": "実際の(データ|数字|コード)を見ると", "label": "前口上", "fix": "削除する", "severity": "hard" },
    { "pattern": "(素晴らしい|いい|鋭い)(ご)?(質問|指摘)", "label": "おべっか", "fix": "削除して回答に入る", "severity": "hard" },
    { "pattern": "おっしゃる通りです", "label": "おべっか", "fix": "削除するか事実で応じる", "severity": "hard" },
    { "pattern": "と言えるでしょう", "label": "不要なぼかし", "fix": "言い切る", "severity": "hard" },
    { "pattern": "ではないでしょうか", "label": "不要なぼかし", "fix": "言い切る", "severity": "hard" },
    { "pattern": "と言っても過言では", "label": "決め文", "fix": "削除する", "severity": "hard" },
    { "pattern": "物語って(い)?ます", "label": "決め文", "fix": "具体的な事実をそのまま書く", "severity": "hard" },
    { "pattern": "一歩前進", "label": "決め文", "fix": "削除する", "severity": "hard" },
    { "pattern": "新しい(局面|フェーズ|ステージ)", "label": "決め文", "fix": "削除する", "severity": "hard" },
    { "pattern": "表裏一体", "label": "決め文", "fix": "削除する", "severity": "hard" },
    { "pattern": "ここに[^。]{0,8}狙いがあり", "label": "決め文", "fix": "削除する", "severity": "hard" },
    { "pattern": "今後の(動向|展開|方向性)", "label": "決め文", "fix": "削除する", "severity": "hard" },
    { "pattern": "が明確になりました", "label": "決め文", "fix": "何が分かったかを具体的に書く", "severity": "hard" },
    { "pattern": "いかがでした", "label": "AI定型", "fix": "削除する", "severity": "hard" },
    { "pattern": "に過ぎません", "label": "数値への評価", "fix": "数字だけ書く", "severity": "hard" },
    { "pattern": "(変更|移行|増加|減少|拡大|縮小|実施|達成|確認)が(発表|確認|報告|判明)され", "label": "抽象名詞の名詞化", "fix": "誰が何をしたかの動詞に直す", "severity": "hard" },
    { "pattern": "(化|性|的)(の|な)(実現|向上|最適化|効率化)", "label": "抽象名詞の連結", "fix": "平易な動詞に直す", "severity": "hard" },
    { "pattern": "重要な(ポイント|要素)", "label": "前口上", "fix": "中身を書く", "severity": "soft" },
    { "pattern": "という点で", "label": "AI定型", "fix": "文を分ける", "severity": "soft" },
    { "pattern": "の観点から", "label": "AI定型", "fix": "主語と動作で書き直す", "severity": "soft" },
    { "pattern": "以下の通りです", "label": "前口上", "fix": "列挙をそのまま置く", "severity": "soft" },
    { "pattern": "様々な", "label": "曖昧な修飾", "fix": "具体名を書くか削除する", "severity": "soft" },
    { "pattern": "しっかりと", "label": "曖昧な修飾", "fix": "削除する", "severity": "soft" },
    { "pattern": "と考えられます", "label": "不要なぼかし", "fix": "言い切る", "severity": "soft" },
    { "pattern": "ことになります", "label": "不要なぼかし", "fix": "「〜します」に直す", "severity": "soft" },
    { "pattern": "を示しています", "label": "硬い述語", "fix": "具体的な動詞に直す", "severity": "soft" },
    { "pattern": "させていただきます", "label": "過剰敬語", "fix": "「〜します」に直す", "severity": "soft" },
    { "pattern": "していきましょう", "label": "読者案内", "fix": "削除する", "severity": "soft" },
    { "pattern": "深掘り", "label": "AI定型", "fix": "具体的な動作を書く", "severity": "soft" },
    { "pattern": "ぜひ[^。]{0,24}ください", "label": "AI定型", "fix": "削除する", "severity": "soft" }
  ]
}
